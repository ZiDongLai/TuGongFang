<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: do not silently upload/transfer local projects, original
     photos, or editing history. Users can export/import a Project ZIP. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
