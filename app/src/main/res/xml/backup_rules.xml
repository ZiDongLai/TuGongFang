<?xml version="1.0" encoding="utf-8"?>
<!-- API 26-30: project photos and JSON are private local data. Back up explicitly
     from the in-app Project ZIP export, rather than the Android backup service. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
